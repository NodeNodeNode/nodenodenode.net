---
import { hasAsset } from '../lib/content.js'

const { item } = Astro.props

// 中文条目要显眼,外文条目只是标一下 —— 别让人点进去才发现要啃外语
const LANG = { zh: '中文', en: 'EN', de: '德文', ja: '日文' }
const lang = LANG[item.lang] ?? item.lang

// 书的封面按 ISBN 命名存在 public/img/books/。没有的条目照常渲染成纯文字行,
// 不占位、不留空框 —— 只有一两本有封面时,一排空框比没有封面更难看。
const cover = item.isbn ? `/img/books/${item.isbn}.jpg` : ''
const hasCover = hasAsset(cover)
---

<li class:list={['rr', hasCover && 'rr--cover']}>
  {
    hasCover && (
      <a class="rr__cover" href={item.href} target="_blank" rel="noopener noreferrer" tabindex="-1" aria-hidden="true">
        <img src={cover} alt="" width="120" height="168" loading="lazy" />
      </a>
    )
  }
  <div class="rr__body">
    <a class="rr__link" href={item.href} target="_blank" rel="noopener noreferrer">
      <span class="pin"></span>
      <span class="rr__title pixel">{item.title}</span>
      <span class:list={['rr__lang', 'pixel', `rr__lang--${item.lang}`]}>{lang}</span>
    </a>
    <p class="rr__note">{item.note}</p>
  </div>
</li>

<style>
  .rr {
    border-top: var(--line-soft);
    padding-block: var(--s2);
  }

  /* 有封面的条目改成「图 + 文」两栏。封面只是识别用的小图,
     不抢注意力,所以宽度压到 120px */
  .rr--cover {
    display: flex;
    gap: var(--s3);
    align-items: flex-start;
  }

  .rr__cover {
    flex: none;
    display: block;
  }

  .rr__cover img {
    width: 120px;
    height: auto;
    border: var(--line);
  }

  .rr__body {
    flex: 1;
    min-width: 0;
  }

  .rr:last-child {
    border-bottom: var(--line-soft);
  }

  .rr__link {
    display: flex;
    align-items: center;
    gap: var(--s2);
    text-decoration: none;
  }

  .rr__title {
    font-size: var(--px-1);
    text-decoration: underline;
    text-underline-offset: 4px;
    text-decoration-color: var(--grey-400);
  }

  .rr__link:hover .rr__title {
    text-decoration-color: var(--signal);
  }

  .rr__link:hover .pin {
    background: var(--signal);
  }

  /* 语言标记要明显 —— 让人一眼看出哪些要啃英文,别点进去才发现 */
  .rr__lang {
    font-size: var(--px-1);
    padding: 2px var(--s1);
    border: var(--line-soft);
    color: var(--grey-500);
    margin-left: auto;
    flex: none;
  }

  .rr__lang--zh {
    color: var(--ink);
    border-color: var(--ink);
  }

  .rr__note {
    margin-top: var(--s1);
    margin-left: var(--s3);
    color: var(--grey-500);
    font-size: 15px;
    line-height: 24px;
    max-width: 64ch;
  }

  @media (max-width: 560px) {
    .rr__cover img {
      width: 80px;
    }
    .rr--cover {
      gap: var(--s2);
    }
  }
</style>
